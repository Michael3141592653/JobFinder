# Copy to .env (not committed). The app and `just` read it; these values match docker-compose.yml.
DATABASE_URL=postgresql://jobfinder:jobfinder@localhost:5432/jobfinder
TEST_DATABASE_URL=postgresql://jobfinder:jobfinder@localhost:5432/jobfinder_test
# For machine callers (e.g. the scheduler): every API request sends it as "Authorization: Bearer <token>". Make your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=
